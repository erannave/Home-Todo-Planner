{
  "name": "home-todo-planner",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:assets && bun run css:watch & bun run --hot server/index.ts",
    "start": "bun run build:assets && bun run css:build && bun run server/index.ts",
    "build": "bun run build:assets && bun run css:build && bun build --compile --minify server/index.ts --outfile dist/server",
    "build:assets": "cp node_modules/alpinejs/dist/cdn.min.js public/alpine.js && cp node_modules/canvas-confetti/dist/confetti.browser.js public/confetti.js",
    "css:build": "bunx @tailwindcss/cli -i src/styles.css -o public/styles.css --minify",
    "css:watch": "bunx @tailwindcss/cli -i src/styles.css -o public/styles.css --watch",
    "db:seed": "bun run scripts/seed.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "alpinejs": "^3.15.12",
    "canvas-confetti": "^1.9.4",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.14",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
